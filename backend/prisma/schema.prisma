/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model appointment {
  id                                    BigInt                 @id @default(autoincrement())
  patient_id                            BigInt
  doctor_id                             BigInt
  chair_id                              Int                    @db.SmallInt
  appt_date                             DateTime               @db.Date
  slot_time                             DateTime               @db.Time(6)
  planned_service_id                    BigInt
  status                                appointment_status     @default(booked)
  note                                  String?
  booked_by                             BigInt
  booked_at                             DateTime               @default(now()) @db.Timestamptz(6)
  checked_in_at                         DateTime?              @db.Timestamptz(6)
  cancel_reason_id                      Int?                   @db.SmallInt
  cancel_note                           String?
  cancelled_by                          BigInt?
  cancelled_at                          DateTime?              @db.Timestamptz(6)
  staff_appointment_booked_byTostaff    staff                  @relation("appointment_booked_byTostaff", fields: [booked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cancel_reason                         cancel_reason?         @relation(fields: [cancel_reason_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_appointment_cancelled_byTostaff staff?                 @relation("appointment_cancelled_byTostaff", fields: [cancelled_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chair                                 chair                  @relation(fields: [chair_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_appointment_doctor_idTostaff    staff                  @relation("appointment_doctor_idTostaff", fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient                               patient                @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service                               service                @relation(fields: [planned_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appointment_reminder                  appointment_reminder[]
  treatment_record                      treatment_record?

  @@unique([chair_id, appt_date, slot_time], map: "appointment_chair_slot_uq", where: raw("(status <> 'cancelled'::appointment_status)"))
  @@unique([doctor_id, appt_date, slot_time], map: "appointment_doctor_slot_uq", where: raw("(status <> 'cancelled'::appointment_status)"))
  @@index([appt_date], map: "appointment_date_idx")
  @@index([patient_id], map: "appointment_patient_idx")
}

