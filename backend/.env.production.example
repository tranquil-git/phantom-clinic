# Cau hinh production cho API. Chep thanh backend/.env.production (Git bo qua file do)
# hoac nhap cac bien nay vao muc Environment cua host (Render, Railway, Fly.io...).

NODE_ENV=production

# Chuoi ket noi Neon (Vercel -> Storage -> phantom-clinic-db -> Connect), doi database cuoi duong dan
# thanh /TranquilClinicDB. File nay (chay o may: db:deploy, set-password:prod) dung ban ket noi truc tiep;
# bien DATABASE_URL tren Vercel dung ban pooled (host co "-pooler").
# Dan nguyen chuoi Neon dua (?sslmode=require&channel_binding=require) cung duoc.
DATABASE_URL=postgresql://neondb_owner:<mat-khau>@ep-xxxx-xxxx.c-4.ap-southeast-1.aws.neon.tech/TranquilClinicDB?sslmode=verify-full

# Khoa ky cookie dang nhap, toi thieu 32 ky tu, khac ban dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_random_64_hex_chars

# Tuy chon
# PORT=4000            # host thuong tu dat; mac dinh 4000
# HOST=0.0.0.0         # mac dinh 0.0.0.0 khi production, 127.0.0.1 khi dev
# DB_POOL_MAX=5        # mac dinh 10; tren Vercel dat 5
# NODEJS_HELPERS=0     # chi tren Vercel: de Express tu doc body / cookie
# COOKIE_SECURE=false  # chi khi chay ban production tren http://127.0.0.1 (khong HTTPS)
