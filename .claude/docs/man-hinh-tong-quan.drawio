nt color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/queue&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC30&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Bác sĩ · Quản lý xem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="504" width="250" height="82" as="geometry"/></mxCell><mxCell id="c5" value="Thu ngân" style="swimlane;html=1;startSize=34;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;rounded=1;arcSize=4;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1060" y="100" width="290" height="768" as="geometry"/></mxCell><mxCell id="s_price" value="&lt;b&gt;Bảng giá&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/prices&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC40 · UC60 — giá theo ngày khám&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Mọi vai trò xem · QL sửa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_bill" value="&lt;b&gt;Hóa đơn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/billing&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Chờ lập · Còn nợ · Đã thanh toán&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân · Quản lý xem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="386" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_invnew" value="&lt;b&gt;Lập hóa đơn lượt khám&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/billing/new/[recordId]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC41 · UC43&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="504" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_inv" value="&lt;b&gt;Hóa đơn &amp;amp; thu tiền&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/invoices/[id]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC44&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân thu · khác xem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="622" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_cash" value="&lt;b&gt;Chốt két cuối ngày&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/cash&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC45 · UC79&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân chốt · QL xem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="740" width="250" height="82" as="geometry"/></mxCell><mxCell id="c6" value="Quản trị" style="swimlane;html=1;startSize=34;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=15;rounded=1;arcSize=4;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="290" height="768" as="geometry"/></mxCell><mxCell id="s_report" value="&lt;b&gt;Báo cáo quản lý&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/reports&lt;/font