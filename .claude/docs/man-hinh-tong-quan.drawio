<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17"><diagram id="so-do" name="Sơ đồ màn hình"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Website quản lý Nha khoa Nụ Cười Việt — sơ đồ màn hình&lt;/b&gt;&lt;br&gt;Next.js (frontend) → API Node.js/Express (backend) → TranquilClinicDB. Mũi tên: luồng chính của một lượt khám (đặt lịch → tiếp đón → khám → lập hóa đơn → thu tiền → chốt két); nét đứt: dữ liệu ảnh hưởng." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c2" value="Chung" style="swimlane;html=1;startSize=34;fillColor=#eceff1;strokeColor=#78909c;fontStyle=1;fontSize=15;rounded=1;arcSize=4;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="290" height="768" as="geometry"/></mxCell><mxCell id="s_login" value="&lt;b&gt;Đăng nhập&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/login&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC01&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Mọi nhân viên&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#78909c;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_dash" value="&lt;b&gt;Tổng quan&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Số liệu hôm nay theo vai trò&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân · Bác sĩ · Quản lý&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#78909c;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="268" width="250" height="82" as="geometry"/></mxCell><mxCell id="c3" value="Tiếp đón" style="swimlane;html=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;rounded=1;arcSize=4;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="290" height="768" as="geometry"/></mxCell><mxCell id="s_pats" value="&lt;b&gt;Danh sách bệnh nhân&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/patients&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC10&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân · Bác sĩ · Quản lý&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_pat" value="&lt;b&gt;Chi tiết bệnh nhân&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/patients/[id]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC12 · UC13&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân sửa · BS, QL xem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="268" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_book" value="&lt;b&gt;Đặt lịch hẹn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/appointments/new&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC21 · UC22 · UC29 — khung trống theo ca trực&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân · Bác sĩ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="386" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_appt" value="&lt;b&gt;Lịch hẹn theo ngày&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/appointments&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC20 · UC23 · UC24 · UC27 · UC28&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân thao tác · BS, QL xem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="504" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_remind" value="&lt;b&gt;Nhắc lịch hẹn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/reminders&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC25 · UC26&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="622" width="250" height="82" as="geometry"/></mxCell><mxCell id="s_patnew" value="&lt;b&gt;Hồ sơ bệnh nhân mới&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; face=&quot;monospace&quot;&gt;/patients/new&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC11 — mở từ Đặt lịch / Bệnh nhân&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5d6b79&quot; style=&quot;font-size:10px&quot;&gt;Lễ tân&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="740" width="250" height="82" as="geometry"/></mxCell><mxCell id="c4" value="Điều trị" style="swimlane;html=1;startSize=34;fillC